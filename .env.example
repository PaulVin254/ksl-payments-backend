# Server Configuration
PORT=3000
NODE_ENV=development
ADMIN_SECRET_KEY=change_this_to_a_secure_secret_token
FRONTEND_URL=http://localhost:5173,http://localhost:8080,https://ephphathakenya.co.ke

# Safaricom Daraja M-Pesa Settings
# Set to 'sandbox' for development testing, or 'production' when Safaricom approves your live Till
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=your_daraja_consumer_key_here
DARAJA_CONSUMER_SECRET=your_daraja_consumer_secret_here

# Business Shortcode:
# In Sandbox: 174379
# In Production: Your 6-7 digit Store / Head Office Number from Daraja Portal
DARAJA_BUSINESS_SHORTCODE=174379

# Till Number:
# In Sandbox: 174379
# In Production: Your 5-6 digit Buy Goods Till Number (PartyB)
DARAJA_TILL_NUMBER=174379

# Passkey:
# Sandbox standard passkey or production passkey generated from Daraja portal
DARAJA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Callback URL (Must be a publicly accessible HTTPS endpoint):
# e.g., https://your-azure-app.azurewebsites.net/api/mpesa/callback
DARAJA_CALLBACK_URL=https://your-azure-app.azurewebsites.net/api/mpesa/callback

# Transaction Type:
# CustomerPayBillOnline (for Paybill / Sandbox) or CustomerBuyGoodsOnline (for Buy Goods Till)
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline

# Supabase Database (Requires Service Role Key for backend administration)
SUPABASE_URL=https://aojlbhvjvoxofdzzjrud.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Brevo Transactional Email Settings
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=paul@ephphathakenya.co.ke
BREVO_SENDER_NAME=Paul - Ephphatha Sign Language

# Meta Cloud WhatsApp API Settings
# Keep ENABLE_WHATSAPP=false until you have generated a Permanent System User Token from Meta Business Manager
ENABLE_WHATSAPP=false
WHATSAPP_API_TOKEN=your_permanent_meta_system_user_token_here
WHATSAPP_PHONE_NUMBER_ID=1104790996054118
WHATSAPP_CLASS_GROUP_LINK=https://chat.whatsapp.com/JHAPRzElBgQIUhwjHfxkP8
