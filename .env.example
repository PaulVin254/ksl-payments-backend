# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173,http://localhost:8080

# Safaricom Daraja M-Pesa Settings
# Set to 'sandbox' for testing or 'production' for live payments
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=your_daraja_consumer_key_here
DARAJA_CONSUMER_SECRET=your_daraja_consumer_secret_here
# Sandbox shortcode is 174379. In production, use your Buy Goods Store number / Till number
DARAJA_BUSINESS_SHORTCODE=174379
# Standard sandbox passkey or production passkey from Daraja portal
DARAJA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# Must be a public HTTPS URL. On Azure: https://<your-app>.azurewebsites.net/api/mpesa/callback
DARAJA_CALLBACK_URL=https://your-azure-app.azurewebsites.net/api/mpesa/callback
# CustomerBuyGoodsOnline for Buy Goods Till or CustomerPayBillOnline for Paybill
DARAJA_TRANSACTION_TYPE=CustomerBuyGoodsOnline

# Supabase Database (Use Service Role Key so backend can write records securely)
SUPABASE_URL=https://aojlbhvjvoxofdzzjrud.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Brevo Transactional Email Settings
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=paul@ephphathakenya.co.ke
BREVO_SENDER_NAME=Paul - Ephphatha Sign Language

# Meta Cloud WhatsApp API Settings
WHATSAPP_API_TOKEN=your_meta_cloud_api_token_here
WHATSAPP_PHONE_NUMBER_ID=1104790996054118
WHATSAPP_CLASS_GROUP_LINK=https://chat.whatsapp.com/JHAPRzElBgQIUhwjHfxkP8
