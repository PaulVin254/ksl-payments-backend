# Server Configuration
PORT=3001
NODE_ENV=development
ADMIN_SECRET_KEY=change_this_to_a_secure_secret_token
FRONTEND_URL=http://localhost:5173,http://localhost:3000,https://yourbusiness.com

# Safaricom Daraja M-Pesa Settings (Paybill)
# 'sandbox' for testing, 'production' for live payments
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=your_daraja_consumer_key_here
DARAJA_CONSUMER_SECRET=your_daraja_consumer_secret_here

# Your 5 to 7 digit Lipa Na M-Pesa Paybill Number:
# In Sandbox: 174379 (Sandbox test paybill)
# In Production: Your official registered business Paybill number
DARAJA_PAYBILL_NUMBER=174379

# Production or Sandbox Passkey:
# In Sandbox: bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# In Production: Generated on the Daraja portal for your Paybill app
DARAJA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Public Webhook Endpoints (Azure Container App URL or Ngrok for local testing)
# STK Push Callback:
DARAJA_CALLBACK_URL=https://ca-biz-payments.francecentral.azurecontainer.io/api/mpesa/callback

# C2B Manual Paybill URLs:
DARAJA_C2B_VALIDATION_URL=https://ca-biz-payments.francecentral.azurecontainer.io/api/mpesa/c2b/validation
DARAJA_C2B_CONFIRMATION_URL=https://ca-biz-payments.francecentral.azurecontainer.io/api/mpesa/c2b/confirmation

# Secret token appended to callback URLs to reject unauthorized public requests
DARAJA_WEBHOOK_SECRET=your_secure_webhook_secret_here

# Supabase Database (Same Supabase instance, dedicated business tables)
SUPABASE_URL=https://aojlbhvjvoxofdzzjrud.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
